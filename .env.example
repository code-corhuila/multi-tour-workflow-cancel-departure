# Variables the service reads; copy to .env (never versioned) and fill in.
# Address the server listens on inside the container: the gateway sends the sagas to the port 8090
LISTEN_ADDR=:8090
# Base URLs of the two participants (HTTP, inside the platform network).
COMMERCIAL_RESERVATION_BASE_URL=http://multi-tour-commercial-reservation-api:8083
OPERATIONS_COST_BASE_URL=http://multi-tour-operations-cost-api:8084
# issued by the security service for this saga, never versioned
SERVICE_TOKEN=
# public key of the security service, to check the caller's JWT: a file, or the PEM text in JWT_PUBLIC_KEY (one line, line breaks written as
# backslash-n; it wins over the file)
JWT_PUBLIC_KEY_FILE=<path-to-public-key>
# the issuer and the audience the token must carry (the platform's; never empty)
JWT_ISSUER=multi-tour-security
JWT_AUDIENCE=multi-tour
# connection as workflow_cancel_departure_app
DATABASE_URL=postgres://workflow_cancel_departure_app:<password>@postgres:5432/<database>
# Call timing (ADR-004 D10): timeout per attempt, 1s to 30s; attempts per call, 1 to 5. The saga makes one call per reservation besides
# the two of the departure; the request that starts it has a budget of 60 s and the rest goes on in the resumption
STEP_TIMEOUT=5s
STEP_ATTEMPTS=3
# Subjects of the service tokens that may start the saga through the internal route, comma separated (plan D-11). Job 3 by default; a
# cancelled departure cannot be undone, so no other service is let in unless it is listed here.
CANCEL_DEPARTURE_STARTERS=worker-departure-deadlines
